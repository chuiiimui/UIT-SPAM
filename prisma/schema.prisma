generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Batch {
  id              Int              @id @default(autoincrement())
  label           String           @unique
  endYear         Int              @unique
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  groups          ProjectGroup[]
  rubricDeadlines RubricDeadline[]
  students        Student[]
}

model Admin {
  id           Int           @id @default(autoincrement())
  uniqueId     String        @unique
  passwordHash String
  fullName     String
  email        String?
  createdAt    DateTime      @default(now())
  mentorships  GroupMentor[]
}

model Faculty {
  id           Int               @id @default(autoincrement())
  uniqueId     String            @unique
  passwordHash String
  fullName     String
  email        String?
  department   String?
  phone        String?
  designation  String            @default("Assistant Professor")
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  mentorships  GroupMentor[]
  weeklyEvals  WeeklyEntry[]
  rubricMarks  RubricStudentMark[]
}

model Student {
  id              Int                 @id @default(autoincrement())
  uniqueId        String              @unique // AKTU roll number
  passwordHash    String
  fullName        String
  email           String?
  phone           String?
  department      String?
  branch          String?
  section         String?
  semester        String?
  batchId         Int?
  biodataComplete Boolean             @default(false)
  bioNote         String?
  isLeader        Boolean             @default(false)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  groupId         Int?
  batch           Batch?              @relation(fields: [batchId], references: [id])
  group           ProjectGroup?       @relation(fields: [groupId], references: [id])
  invitesSent     GroupInvite[]       @relation("InviteSender")
  weeklyEntries   WeeklyEntry[]
  rubricMarks     RubricStudentMark[]
}

model ProjectGroup {
  id           Int                 @id @default(autoincrement())
  groupCode    String              @unique
  projectTitle String              @default("Untitled Project")
  projectAbout String              @default("")
  domain       String              @default("")
  objectives   String              @default("")
  techStack    String              @default("")
  batchId      Int
  status       String              @default("active")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  batch        Batch               @relation(fields: [batchId], references: [id])
  students     Student[]
  mentors      GroupMentor[]
  invites      GroupInvite[]
  weeklyEntries WeeklyEntry[]
  rubricStatuses RubricGroupStatus[]
  rubricMarks  RubricStudentMark[]
}

model GroupInvite {
  id         Int          @id @default(autoincrement())
  groupId    Int
  aktuRoll   String
  invitedById Int
  status     String       @default("pending") // pending | accepted | rejected
  createdAt  DateTime     @default(now())
  group      ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy  Student      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([groupId, aktuRoll])
}

model GroupMentor {
  id         Int          @id @default(autoincrement())
  groupId    Int
  facultyId  Int
  assignedBy Int?
  assignedAt DateTime     @default(now())
  isPrimary  Boolean      @default(true)
  group      ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  faculty    Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  admin      Admin?       @relation(fields: [assignedBy], references: [id])

  @@unique([groupId, facultyId])
}

model WeeklyEntry {
  id             Int          @id @default(autoincrement())
  groupId        Int
  weekNumber     Int
  summary        String       @default("")
  performance    String? // satisfactory | unsatisfactory
  submissionDate DateTime?
  evaluationDate DateTime?
  evaluatedById  Int?
  updatedAt      DateTime     @updatedAt
  group          ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student        Student?     @relation(fields: [submittedById], references: [id])
  submittedById  Int?
  evaluator      Faculty?     @relation(fields: [evaluatedById], references: [id])

  @@unique([groupId, weekNumber])
}

model RubricDeadline {
  id         Int      @id @default(autoincrement())
  batchId    Int
  rubricCode String // R1..R8
  dueAt      DateTime
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rubricCode])
}

model RubricGroupStatus {
  id             Int          @id @default(autoincrement())
  groupId        Int
  rubricCode     String
  examinerName   String?
  status         String       @default("not_completed") // completed | not_completed
  evaluationDate DateTime?
  slidesPath     String?
  reportPath     String?
  updatedAt      DateTime     @updatedAt
  group          ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, rubricCode])
}

model RubricStudentMark {
  id         Int          @id @default(autoincrement())
  groupId    Int
  rubricCode String
  studentId  Int
  marks      Float        @default(0)
  maxMarks   Float        @default(0)
  facultyId  Int?
  note       String?
  updatedAt  DateTime     @updatedAt
  group      ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty    Faculty?     @relation(fields: [facultyId], references: [id])

  @@unique([groupId, rubricCode, studentId])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  actorRole  String?
  actorId    Int?
  action     String
  entityType String?
  entityId   Int?
  meta       String?
  createdAt  DateTime @default(now())
}
